# ============================================================
# .env — copy this to .env and fill in your values
# ============================================================

# Your Anthropic API key (starts with sk-ant-)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Port for the Express server (default 3000)
PORT=3000

# Lock CORS to your Storyline hosting origin in production
# Leave as * for local development
ALLOWED_ORIGIN=*
